{
  "manifest_version": 3,
  "name": "Disney+ Vietnamese Translator",
  "version": "2.0",
  "description": "Translates Disney+ subtitles to Vietnamese in real-time.",
  "permissions": ["activeTab", "scripting", "storage"],
  "options_page": "options.html",
  "host_permissions": [
    "*://*.disneyplus.com/*",
    "*://script.google.com/*",
    "*://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.disneyplus.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.disneyplus.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
